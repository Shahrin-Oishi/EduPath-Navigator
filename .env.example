# Copy this file to backend/.env and fill in your values

# MongoDB Connection URI
# Local:  mongodb://localhost:27017/edupath-navigator
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/edupath-navigator
MONGO_URI=mongodb://localhost:27017/edupath-navigator

# JWT Secret — change this to a long random string in production
JWT_SECRET=replace_with_a_long_random_secret

# AI API Keys (chat requires a working Groq or OpenAI key)
# Get OpenAI key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Groq chat provider
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Server port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
